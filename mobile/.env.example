# Copia este archivo a `.env` y ajusta la IP a la de tu PC de desarrollo.
# EXPO_PUBLIC_* → Expo la inyecta automáticamente en process.env al iniciar.
# Usa la IP LAN del PC donde corre el backend (NO 'localhost': desde el
# celular apuntaría al propio teléfono). Obtén tu IP con `ipconfig` (Wi-Fi IPv4).
EXPO_PUBLIC_API_URL=http://192.168.0.12:3000
