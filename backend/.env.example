# ════════════════════════════════════════════════════════════════
# ESTILO — Variables de entorno
# Copia este archivo a .env y completa los valores.
# NUNCA commitees el .env real (está en .gitignore).
# ════════════════════════════════════════════════════════════════

# === OBLIGATORIAS (el servidor NO arranca sin estas) ===
DATABASE_URL=postgresql://usuario:password@localhost:5432/estilo_db

# Mínimo 32 caracteres aleatorios. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

PORT=3000
NODE_ENV=development
JWT_EXPIRES_IN=7d

# === SEGURIDAD ===
# Orígenes permitidos para CORS, separados por coma.
# En producción: https://estilo.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# Credenciales Basic Auth para /api-docs (Swagger) EN PRODUCCIÓN.
# En desarrollo Swagger es de acceso libre y estas se ignoran.
# Si quedan vacías en producción, /api-docs se deshabilita por completo.
SWAGGER_USER=
SWAGGER_PASS=

# === SERVICIOS (opcionales en dev; la feature queda deshabilitada) ===

# Chatbot con IA (Anthropic)
ANTHROPIC_API_KEY=

# Subida de imágenes (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Pagos con tarjeta (Stripe)
STRIPE_SECRET_KEY=
# Sin este secret los webhooks de Stripe se RECHAZAN con 401:
STRIPE_WEBHOOK_SECRET=

# Pagos PSE/Nequi/Daviplata (ePayco)
EPAYCO_API_KEY=
EPAYCO_PRIVATE_KEY=
EPAYCO_P_KEY=
EPAYCO_TEST=true
EPAYCO_REDIRECT_URL=
EPAYCO_RESPONSE_URL=

# WhatsApp (Twilio)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=

# Push notifications (Firebase)
FIREBASE_SERVER_KEY=

# ===================== EMAIL (Gmail SMTP) =====================
# Envía los códigos de recuperación de contraseña.
# Requiere generar "Contraseña de aplicación" en tu cuenta Google:
# 1. Ve a https://myaccount.google.com/security
# 2. Activa "Verificación en 2 pasos" si no está activa
# 3. Ve a "Contraseñas de aplicaciones"
# 4. Genera una nueva para "Mail" - "Otro (Estilo)"
# 5. Copia los 16 caracteres SIN espacios
# Prueba el envío con: node scripts/test-email.js tu-correo@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=contraseña-de-aplicacion-16-chars
SMTP_FROM_NAME=Estilo
SMTP_FROM_EMAIL=tu-correo@gmail.com

# OAuth Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# OAuth Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback
