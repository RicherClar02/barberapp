# URL base del backend. Host pelado, SIN /api al final: las llamadas del
# frontend ya incluyen el prefijo (api.post('/api/auth/login')).
#
# Desarrollo local:
#   VITE_API_URL=http://localhost:3000
# Producción (Vercel → Settings → Environment Variables):
#   VITE_API_URL=https://estilo-backend.onrender.com
#
# Vite la inlinea en tiempo de BUILD, no de ejecución: si la cambias en Vercel
# hay que volver a desplegar para que surta efecto.
VITE_API_URL=http://localhost:3000
